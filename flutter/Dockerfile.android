FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FLUTTER_BUILD_VERSION=3.24.5
ARG RUST_VERSION=1.75
ARG CARGO_NDK_VERSION=3.1.2
ARG FLUTTER_RUST_BRIDGE_VERSION=1.80.1
ARG CARGO_EXPAND_VERSION=1.0.95
ARG VCPKG_COMMIT_ID=120deac3062162151622ca4860575a33844ba10b
ARG ANDROID_NDK_RELEASE=r28c
ARG ANDROID_CMDLINE_TOOLS_VERSION=11076708
ARG ANDROID_API_LEVEL=34
ARG ANDROID_BUILD_TOOLS_VERSION=34.0.0

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_NDK_RELEASE=${ANDROID_NDK_RELEASE}
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/${ANDROID_NDK_RELEASE}
ENV ANDROID_NDK_ROOT=/opt/android-sdk/ndk/${ANDROID_NDK_RELEASE}
ENV FLUTTER_HOME=/opt/flutter
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH=/opt/flutter/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/root/.cargo/bin:/usr/lib/jvm/java-17-openjdk-amd64/bin:${PATH}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        clang \
        cmake \
        curl \
        file \
        g++ \
        g++-multilib \
        gcc-multilib \
        git \
        libasound2-dev \
        libc6-dev \
        libclang-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer1.0-dev \
        libgtk-3-dev \
        libpam0g-dev \
        libpulse-dev \
        libunwind-dev \
        libva-dev \
        libxcb-randr0-dev \
        libxcb-shape0-dev \
        libxcb-xfixes0-dev \
        libxdo-dev \
        libxfixes-dev \
        llvm-dev \
        nasm \
        ninja-build \
        openjdk-17-jdk-headless \
        pkg-config \
        python3 \
        unzip \
        wget \
        xz-utils \
        zip && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/.android && \
    touch /root/.android/repositories.cfg && \
    mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools" && \
    curl -fsSL -o /tmp/cmdline-tools.zip "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" && \
    unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_SDK_ROOT}/cmdline-tools" && \
    mv "${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools" "${ANDROID_SDK_ROOT}/cmdline-tools/latest" && \
    yes | sdkmanager --licenses >/dev/null && \
    sdkmanager \
        "platform-tools" \
        "platforms;android-${ANDROID_API_LEVEL}" \
        "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" && \
    rm -f /tmp/cmdline-tools.zip

RUN mkdir -p "${ANDROID_SDK_ROOT}/ndk" && \
    curl -fsSL -o /tmp/android-ndk.zip "https://dl.google.com/android/repository/android-ndk-${ANDROID_NDK_RELEASE}-linux.zip" && \
    unzip -q /tmp/android-ndk.zip -d "${ANDROID_SDK_ROOT}/ndk" && \
    if [ -d "${ANDROID_SDK_ROOT}/ndk/android-ndk-${ANDROID_NDK_RELEASE}" ]; then mv "${ANDROID_SDK_ROOT}/ndk/android-ndk-${ANDROID_NDK_RELEASE}" "${ANDROID_NDK_HOME}"; fi && \
    rm -f /tmp/android-ndk.zip

RUN curl -fsSL -o /tmp/flutter.tar.xz "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_BUILD_VERSION}-stable.tar.xz" && \
    tar -xJf /tmp/flutter.tar.xz -C /opt && \
    rm -f /tmp/flutter.tar.xz && \
    flutter config --no-analytics && \
    flutter precache --android

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | bash -s -- -y --default-toolchain "${RUST_VERSION}" && \
    rustup default "${RUST_VERSION}" && \
    cargo install cargo-ndk --version "${CARGO_NDK_VERSION}" --locked && \
    cargo install cargo-expand --version "${CARGO_EXPAND_VERSION}" --locked && \
    cargo install flutter_rust_bridge_codegen --version "${FLUTTER_RUST_BRIDGE_VERSION}" --features uuid --locked

RUN git clone https://github.com/microsoft/vcpkg "${VCPKG_ROOT}" && \
    cd "${VCPKG_ROOT}" && \
    git checkout "${VCPKG_COMMIT_ID}" && \
    ./bootstrap-vcpkg.sh -disableMetrics

COPY flutter/docker/android-build.sh /usr/local/bin/android-build.sh
RUN chmod +x /usr/local/bin/android-build.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/android-build.sh"]
